---
const links = [
  { href: '#que-es', label: 'Qué es' },
  { href: '#beneficios', label: 'Beneficios' },
  { href: '#recomendaciones', label: 'Práctica' },
  { href: '#pausas', label: 'Pausas' },
  { href: '#quiz', label: 'Quiz' },
];
---

<nav class="nav" id="navbar" aria-label="Navegación principal">
  <div class="nav__inner container">
    <a href="#" class="nav__logo" aria-label="Inicio">
      muévete<span>.</span>
    </a>

    <button class="nav__toggle" id="nav-toggle" aria-expanded="false" aria-controls="nav-menu" aria-label="Abrir menú">
      <span></span>
      <span></span>
    </button>

    <ul class="nav__links" id="nav-menu" role="list">
      {links.map(({ href, label }) => (
        <li><a href={href}>{label}</a></li>
      ))}
    </ul>
  </div>
</nav>

<script>
  const toggle = document.getElementById('nav-toggle')!;
  const menu = document.getElementById('nav-menu')!;
  const navbar = document.getElementById('navbar')!;

  toggle.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    menu.classList.toggle('open');
  });

  menu.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      toggle.setAttribute('aria-expanded', 'false');
      menu.classList.remove('open');
    });
  });

  window.addEventListener('scroll', () => {
    navbar.classList.toggle('scrolled', window.scrollY > 40);
  }, { passive: true });
</script>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: var(--space-sm) 0;
    transition: background var(--transition), border-color var(--transition);
    border-bottom: 1px solid transparent;
  }

  .nav.scrolled {
    background: rgba(250, 247, 242, 0.92);
    backdrop-filter: blur(10px);
    border-bottom-color: var(--c-border);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav__logo {
    font-family: var(--ff-display);
    font-size: 1.4rem;
    font-weight: 800;
    font-style: italic;
    color: var(--c-ink);
    letter-spacing: -0.02em;
  }

  .nav__logo span {
    color: var(--c-coral);
  }

  .nav__links {
    display: flex;
    list-style: none;
    gap: 2px;
  }

  .nav__links a {
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--c-ink-soft);
    padding: 6px 14px;
    border-radius: var(--radius-full);
    transition: color var(--transition), background var(--transition);
  }

  .nav__links a:hover {
    color: var(--c-ink);
    background: rgba(0,0,0,0.04);
  }

  .nav__toggle {
    display: none;
    flex-direction: column;
    gap: 6px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
  }

  .nav__toggle span {
    width: 22px;
    height: 1.5px;
    background: var(--c-ink);
    transition: transform var(--transition), opacity var(--transition);
  }

  @media (max-width: 768px) {
    .nav__toggle { display: flex; }

    .nav__links {
      position: fixed;
      inset: 0;
      flex-direction: column;
      background: var(--c-paper);
      padding: 6rem var(--space-lg);
      gap: var(--space-xs);
      transform: translateX(100%);
      transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .nav__links.open {
      transform: translateX(0);
    }

    .nav__links a {
      font-family: var(--ff-display);
      font-size: var(--fs-xl);
      font-style: italic;
      padding: var(--space-sm) 0;
      border-radius: 0;
      border-bottom: 1px solid var(--c-border);
    }

    .nav__toggle[aria-expanded="true"] span:first-child {
      transform: translateY(3.75px) rotate(45deg);
    }
    .nav__toggle[aria-expanded="true"] span:last-child {
      transform: translateY(-3.75px) rotate(-45deg);
    }
  }
</style>
