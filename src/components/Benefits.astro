---
const benefits = [
  {
    accent: 'var(--c-coral)',
    accentBg: 'var(--c-coral)',
    title: 'Salud cardiovascular',
    description: 'La actividad física regular ayuda a reducir el riesgo de enfermedades cardiovasculares y presión arterial alta. Tu corazón se fortalece y la circulación mejora con cada movimiento.',
    stat: '–35 %',
    statLabel: 'riesgo de enfermedad coronaria',
    source: 'OMS, 2022',
  },
  {
    accent: 'var(--c-violet)',
    accentBg: 'var(--c-violet)',
    title: 'Menos sedentarismo',
    description: 'Moverse regularmente puede ayudar a disminuir molestias musculares y de espalda relacionadas con permanecer demasiado tiempo en una misma posición. Especialmente relevante para quienes estudian o trabajan sentados.',
    stat: '80 %',
    statLabel: 'de adultos no cumplen niveles recomendados',
    source: 'OMS, 2024',
  },
  {
    accent: 'var(--c-teal)',
    accentBg: 'var(--c-teal)',
    title: 'Bienestar mental',
    description: 'La actividad física puede mejorar el estado de ánimo, ayudar a reducir el estrés y favorecer un mejor descanso. El ejercicio libera endorfinas y contribuye a una mejor calidad de sueño.',
    stat: '–30 %',
    statLabel: 'en síntomas de depresión',
    source: 'CDC, 2023',
  },
];
---

<section class="bene section" id="beneficios">
  <div class="container">
    <div class="bene__header animate-on-scroll">
      <span class="tag" style="background: var(--c-yellow-soft); color: #9a7b1a;">Aprender</span>
      <h2>Beneficios de<br/><em>mantenerte activo</em></h2>
      <p class="bene__sub">
        Mover tu cuerpo transforma tu salud de maneras que quizás no imaginas.
        Respaldados por la ciencia.
      </p>
    </div>

    <div class="bene__stack">
      {benefits.map((b, i) => (
        <article class="bene__card animate-on-scroll" style={`transition-delay: ${i * 0.12}s`}>
          <div class="bene__card-left">
            <div class="bene__card-stat" style={`color: ${b.accent}`}>
              <span class="bene__stat-num">{b.stat}</span>
              <span class="bene__stat-label">{b.statLabel}</span>
            </div>
            <cite class="bene__source">{b.source}</cite>
          </div>
          <div class="bene__card-right">
            <div class="bene__card-bar" style={`background: ${b.accentBg}`} aria-hidden="true"></div>
            <h3>{b.title}</h3>
            <p>{b.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .bene__header {
    margin-bottom: var(--space-xl);
  }

  .bene__header h2 {
    font-size: var(--fs-3xl);
    margin-top: var(--space-sm);
  }

  .bene__header em { color: var(--c-coral); }

  .bene__sub {
    font-size: var(--fs-lg);
    color: var(--c-ink-soft);
    max-width: 520px;
    margin-top: var(--space-sm);
    line-height: 1.6;
  }

  .bene__stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .bene__card {
    display: grid;
    grid-template-columns: 260px 1fr;
    background: var(--c-white);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: box-shadow var(--transition), transform var(--transition);
  }

  .bene__card:hover {
    box-shadow: 0 8px 32px rgba(0,0,0,0.06);
    transform: translateY(-2px);
  }

  .bene__card-left {
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: var(--c-paper-warm);
    border-right: 1px solid var(--c-border);
  }

  .bene__card-stat { display: flex; flex-direction: column; }

  .bene__stat-num {
    font-family: var(--ff-display);
    font-size: var(--fs-3xl);
    font-weight: 900;
    line-height: 1;
  }

  .bene__stat-label {
    font-size: var(--fs-sm);
    color: var(--c-ink-soft);
    margin-top: 6px;
    line-height: 1.3;
  }

  .bene__source {
    font-size: var(--fs-xs);
    color: var(--c-ink-muted);
    font-style: normal;
    margin-top: var(--space-sm);
  }

  .bene__card-right {
    padding: var(--space-lg);
    position: relative;
  }

  .bene__card-bar {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
  }

  .bene__card-right h3 {
    font-size: var(--fs-xl);
    margin-bottom: var(--space-xs);
  }

  .bene__card-right p {
    color: var(--c-ink-soft);
    line-height: 1.7;
  }

  @media (max-width: 768px) {
    .bene__card {
      grid-template-columns: 1fr;
    }

    .bene__card-left {
      border-right: none;
      border-bottom: 1px solid var(--c-border);
      padding: var(--space-md);
    }
  }
</style>
