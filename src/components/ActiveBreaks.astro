---
const exercises = [
  { name: 'Rotación de cuello', duration: '30 seg', desc: 'Gira lentamente la cabeza en círculos, alternando la dirección.' },
  { name: 'Estiramiento de brazos', duration: '30 seg', desc: 'Extiende los brazos sobre la cabeza y estira hacia cada lado.' },
  { name: 'Rotación de hombros', duration: '30 seg', desc: 'Rota los hombros hacia adelante y luego hacia atrás.' },
  { name: 'Sentadillas suaves', duration: '1 min', desc: 'Realiza 10 sentadillas suaves con los pies al ancho de hombros.' },
  { name: 'Estiramiento de espalda', duration: '30 seg', desc: 'De pie, inclínate hacia adelante dejando caer los brazos.' },
  { name: 'Caminata en el lugar', duration: '1 min', desc: 'Camina levantando las rodillas, moviendo los brazos.' },
];

const triggers = [
  'Cada 45-60 minutos de estar sentado',
  'Al sentir tensión en cuello u hombros',
  'Entre tareas o bloques de estudio',
  'Duración ideal: 5 a 10 minutos',
];
---

<section class="breaks section" id="pausas">
  <div class="container">
    <div class="breaks__header animate-on-scroll">
      <span class="tag" style="background: rgba(232,87,61,0.1); color: var(--c-coral);">Aplicar</span>
      <h2>Pausas<br/><em>activas</em></h2>
      <p class="breaks__sub">
        Las pausas activas son interrupciones breves durante periodos prolongados de sedentarismo.
        Rompen la inactividad, mejoran la circulación y previenen molestias.
      </p>
    </div>

    <div class="breaks__layout">
      <div class="breaks__left animate-on-scroll">
        <h3>¿Cuándo hacer una pausa?</h3>
        <ul class="breaks__triggers">
          {triggers.map(t => (
            <li>
              <span class="breaks__check" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                  <path d="M3 8l3.5 3.5L13 5" stroke="var(--c-teal)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              {t}
            </li>
          ))}
        </ul>

        <div class="breaks__callout">
          <p>
            <strong>Dato CDC:</strong> Interrumpir el tiempo sedentario con breves periodos
            de actividad ligera mejora los niveles de glucosa en sangre y reduce el riesgo metabólico,
            incluso si la actividad total del día no cambia.
          </p>
        </div>
      </div>

      <div class="breaks__right animate-on-scroll" style="transition-delay: 0.15s">
        <div class="breaks__routine-header">
          <h3>Rutina de 5 minutos</h3>
          <span class="breaks__badge">6 ejercicios</span>
        </div>
        <ol class="breaks__steps">
          {exercises.map((ex, i) => (
            <li class="breaks__step">
              <span class="breaks__step-num" aria-hidden="true">{i + 1}</span>
              <div class="breaks__step-body">
                <div class="breaks__step-top">
                  <h4>{ex.name}</h4>
                  <span class="breaks__dur">{ex.duration}</span>
                </div>
                <p>{ex.desc}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .breaks__header { margin-bottom: var(--space-xl); }

  .breaks__header h2 {
    font-size: var(--fs-3xl);
    margin-top: var(--space-sm);
  }

  .breaks__header em { color: var(--c-coral); }

  .breaks__sub {
    font-size: var(--fs-lg);
    color: var(--c-ink-soft);
    max-width: 520px;
    margin-top: var(--space-sm);
    line-height: 1.6;
  }

  .breaks__layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: start;
  }

  /* Left column */
  .breaks__left h3 {
    font-size: var(--fs-xl);
    margin-bottom: var(--space-md);
  }

  .breaks__triggers {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
  }

  .breaks__triggers li {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    color: var(--c-ink-soft);
  }

  .breaks__check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    background: var(--c-teal-bg);
    border-radius: 50%;
    flex-shrink: 0;
  }

  .breaks__callout {
    background: var(--c-paper-warm);
    border-left: 4px solid var(--c-yellow);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    padding: var(--space-md);
  }

  .breaks__callout p {
    font-size: var(--fs-sm);
    color: var(--c-ink-soft);
    line-height: 1.6;
  }

  /* Right column */
  .breaks__right {
    background: var(--c-white);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
  }

  .breaks__routine-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-md);
  }

  .breaks__routine-header h3 {
    font-size: var(--fs-xl);
  }

  .breaks__badge {
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--c-coral);
    background: rgba(232,87,61,0.08);
    padding: 4px 12px;
    border-radius: var(--radius-full);
  }

  .breaks__steps {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .breaks__step {
    display: flex;
    gap: var(--space-sm);
    padding: var(--space-sm);
    border-radius: var(--radius-md);
    transition: background var(--transition);
  }

  .breaks__step:hover { background: var(--c-paper-warm); }

  .breaks__step-num {
    width: 30px;
    height: 30px;
    background: var(--c-ink);
    color: var(--c-paper);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--fs-sm);
    font-weight: 700;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .breaks__step-top {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin-bottom: 2px;
  }

  .breaks__step-top h4 { font-size: var(--fs-sm); }

  .breaks__dur {
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--c-teal);
    background: var(--c-teal-bg);
    padding: 1px 8px;
    border-radius: var(--radius-full);
  }

  .breaks__step-body p {
    font-size: var(--fs-xs);
    color: var(--c-ink-muted);
  }

  @media (max-width: 768px) {
    .breaks__layout { grid-template-columns: 1fr; }
  }
</style>
